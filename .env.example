# Kwatt · variables d'environnement
#
# Copier ce fichier en .env (JAMAIS versionné) puis le remplir :
#   cp .env.example .env
#
# Le même fichier sert au développement et à la production (VPS, docs/DEPLOIEMENT.md).
# Les lignes marquées [prod] sont celles à changer sur le serveur.
# Une variable vide ou commentée prend sa valeur par défaut (indiquée entre parenthèses).
# Secrets : uniquement des caractères hexadécimaux, sans guillemets, par exemple
#   openssl rand -hex 32

# =====================================================================================
# Production (VPS) : domaine et certificat HTTPS
# =====================================================================================
# [prod] Nom de domaine de l'API, déjà pointé vers l'adresse IP du VPS (enregistrement DNS A/AAAA).
DOMAIN=kwatt.example.com
# [prod] Adresse prévenue par Let's Encrypt (expiration du certificat, incident).
ACME_EMAIL=admin@example.com

# =====================================================================================
# Base de données PostgreSQL 16
# =====================================================================================
# Identifiants du conteneur postgres (docker compose, développement et production).
POSTGRES_USER=kwatt
# [prod] Mot de passe solide : openssl rand -hex 24
POSTGRES_PASSWORD=kwatt
POSTGRES_DB=kwatt
# Connexion du serveur en développement (en production, le compose la construit lui-même
# à partir des POSTGRES_* ci-dessus, vers le conteneur « postgres »).
DATABASE_URL=postgres://kwatt:kwatt@localhost:5432/kwatt
# Connexions simultanées du serveur (10).
# DATABASE_POOL_MAX=10
# Appliquer les migrations au démarrage du serveur (false en développement ; toujours true
# en production, posé par deploy/docker-compose.prod.yml). Sinon : pnpm db:migrate.
MIGRATE_ON_START=false
# Dossier des migrations (db/migrations du dépôt).
# MIGRATIONS_DIR=

# =====================================================================================
# Serveur (@kwatt/server)
# =====================================================================================
# development | test | production (en production, les secrets JWT sont obligatoires).
NODE_ENV=development
# Adresse et port d'écoute (0.0.0.0, 8080).
HOST=0.0.0.0
API_PORT=8080
# Adresse publique du serveur : liens des e-mails, URL des photos (/media), liens de partage.
# En production, le compose pose https://DOMAIN.
PUBLIC_BASE_URL=http://localhost:8080
# fatal | error | warn | info | debug | trace | silent (info).
LOG_LEVEL=info
# true derrière un proxy (Caddy) pour lire la vraie adresse IP des clients (false ; true en prod).
TRUST_PROXY=false
# Origines web autorisées (CORS), séparées par des virgules. L'appli mobile n'en a pas besoin ;
# seule la version web de vérification en a besoin. En développement, localhost est accepté.
CORS_ORIGINS=

# --- Jetons de session ----------------------------------------------------------------
# [prod] Clé de signature des jetons d'accès (JWT, 15 min) : openssl rand -hex 32
# Vide en développement : clé tirée au hasard, les sessions ne survivent pas au redémarrage.
JWT_ACCESS_SECRET=
# [prod] Clé des empreintes des jetons de renouvellement et des codes : openssl rand -hex 32
JWT_REFRESH_SECRET=
# Durée du jeton d'accès en secondes (900 = 15 min) et du renouvellement en jours (30).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Mémoire d'argon2id en Kio pour les mots de passe (19456 = 19 Mio, recommandation OWASP).
# ARGON2_MEMORY_KIB=19456

# --- Limitation de débit -----------------------------------------------------------------
# Requêtes par minute et par adresse IP, toutes routes (300).
RATE_LIMIT_GLOBAL_PER_MIN=300
# Essais par minute sur la connexion, l'inscription, les codes (5 par IP et 5 par compte).
RATE_LIMIT_AUTH_PER_MIN=5

# =====================================================================================
# E-mail (codes à 6 chiffres, mot de passe oublié, alertes)
# =====================================================================================
# SMTP_HOST vide : les e-mails, codes compris, sont écrits dans le journal du serveur
# (développement, ou petit déploiement entre amis : ./deploy/compose.sh logs api).
SMTP_HOST=
# 587 (STARTTLS, SMTP_SECURE=false) ou 465 (TLS direct, SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché.
MAIL_FROM="Kwatt <no-reply@example.com>"

# =====================================================================================
# Notifications push (service d'Expo, aucun module natif)
# =====================================================================================
# false coupe tout envoi de push (la liste dans l'appli et le temps réel restent).
PUSH_ENABLED=true
# Jeton d'accès Expo, seulement si « Enhanced push security » est activé sur expo.dev.
EXPO_ACCESS_TOKEN=
# Adresse du service (https://exp.host/--/api/v2/push/send).
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# =====================================================================================
# Médias (photos de profil)
# =====================================================================================
# Dossier des fichiers envoyés, servis sous /media/ (dossier temporaire du système en
# développement ; /data/media, un volume Docker, en production).
MEDIA_DIR=
# Taille maximale d'un fichier envoyé, en octets (5242880 = 5 Mio).
MEDIA_MAX_BYTES=5242880
# D-10 : true = photos de profil publiées sans modération (déploiement entre amis, sans
# modérateur). false = chaque photo attend la validation d'un modérateur.
PHOTO_AUTO_APPROVE=false

# =====================================================================================
# Administration et tâches planifiées
# =====================================================================================
# [prod] Jeton des routes /v1/admin (en-tête Authorization: Bearer …) : openssl rand -hex 32
# Vide : les routes d'administration n'existent pas. La CLI (admin …) n'en a pas besoin.
ADMIN_TOKEN=
# Tâches planifiées dans le processus (effacement des comptes à J+30, purges…) (true).
JOBS_ENABLED=true

# =====================================================================================
# Temps réel
# =====================================================================================
# Ping des WebSocket en ms : une connexion qui ne répond pas est coupée au ping suivant (30000).
WS_PING_INTERVAL_MS=30000
# Délai avant d'annoncer un joueur hors ligne, pour absorber une reconnexion (5000).
PRESENCE_GRACE_MS=5000

# =====================================================================================
# Liens de partage (/s/CODE salons, /l/CODE ligues)
# =====================================================================================
# Lien d'installation de l'appli montré sur ces pages (page expo.dev, magasin d'applications…).
APP_INSTALL_URL=
# Schéma des liens profonds de l'appli (kwatt → kwatt://salon/CODE).
APP_SCHEME=kwatt

# =====================================================================================
# Moteur du Ludo (service séparé, services/ludo-ai)
# =====================================================================================
# Adresse vue par le serveur (en production, le compose pose http://ludo-ai:8090).
LUDO_AI_URL=http://localhost:8090
LUDO_AI_PORT=8090

# =====================================================================================
# Sauvegardes (production, service « backup »)
# =====================================================================================
# Dossier des sauvegardes sur le VPS, relatif à deploy/ (./backups → deploy/backups).
BACKUP_DIR=./backups
# Nombre de jours gardés (14) et heure de la sauvegarde quotidienne, en UTC (2 = 3 h à Douala).
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=2

# =====================================================================================
# Tests (pnpm test) : chaque suite crée puis supprime sa propre base
# =====================================================================================
# Connexion d'un rôle autorisé à créer des bases (par défaut DATABASE_URL).
# TEST_DATABASE_URL=postgres://kwatt:kwatt@localhost:5432/kwatt
# Préfixe des bases de test (kwatt_test_).
# TEST_DB_PREFIX=kwatt_test_

# =====================================================================================
# Appli mobile : voir apps/mobile/.env.example (seules les variables EXPO_PUBLIC_ y arrivent)
# =====================================================================================
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080/v1/ws
