# Copier en .env (jamais versionné) et remplir.

# --- Base de données ---
POSTGRES_USER=kwatt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kwatt
DATABASE_URL=postgres://kwatt:change-me@localhost:5432/kwatt

# --- Redis (présence, pub/sub entre nœuds) ---
REDIS_URL=redis://localhost:6379

# --- Serveur ---
NODE_ENV=development
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Secrets JWT : 64 octets aléatoires en base64 (openssl rand -base64 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- E-mail (codes de vérification et mot de passe oublié) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kwatt <no-reply@example.com>"

# --- Moteur Ludo (service séparé) ---
LUDO_AI_URL=http://localhost:8090
LUDO_AI_PORT=8090

# --- Appli mobile (Expo : seules les variables EXPO_PUBLIC_ sont lues côté appli) ---
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws
