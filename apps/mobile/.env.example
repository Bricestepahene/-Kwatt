# Copier en apps/mobile/.env (jamais versionné). Seules les variables EXPO_PUBLIC_ arrivent dans l'appli.
# Sur un téléphone avec Expo Go, « localhost » désigne le téléphone : mettre l'adresse IP de l'ordinateur
# (ex. http://192.168.1.20:8080) ou l'adresse publique du VPS.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Par défaut : EXPO_PUBLIC_API_URL + /v1/ws (en ws:// ou wss://)
EXPO_PUBLIC_WS_URL=ws://localhost:8080/v1/ws

# Identifiant du projet sur expo.dev (affiché par « eas init »)
EAS_PROJECT_ID=

# Domaine des liens de partage https://<domaine>/s/CODE (facultatif)
KWATT_WEB_DOMAIN=
