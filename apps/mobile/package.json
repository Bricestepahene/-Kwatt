    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/mobile",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:sounds": "node scripts/generate-sounds.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "routes:doc": "UPDATE_ROUTES_DOC=1 vitest run --root ../.. apps/mobile/src/navigation/routes.test.ts",
    "start:go": "expo start --go",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
