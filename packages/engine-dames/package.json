{
  "name": "@kwatt/engine-dames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./puzzles/*": "./puzzles/*"
  },
  "scripts": {
    "build": "tsc -b",
    "puzzles": "tsc -b && node dist/scripts/generate-puzzles.js",
    "match": "tsc -b && node dist/scripts/match.js"
  },
  "dependencies": {
    "@kwatt/rules-dames": "workspace:*"
  }
}
